# Full reference: docs/CONFIGURATION.md

# Required: PostgreSQL
# Supply the connection URL from your PostgreSQL service.
DATABASE_URL=postgresql://agent:replace-me@localhost:5432/imessage_agent

# Optional legacy migration inputs for an existing deployment.
# Fresh deployments and local environments leave these unset and configure the
# owner through the public dashboard. Remove a legacy value manually
# only after its encrypted database migration is verified.
# OWNER_PHONE_NUMBER=+15551234567
# Former Render Blueprint alias.
# OWNER_PHONE_NUMBER_E164_EXAMPLE_PLUS19495550123=+19495550123

# Required: explicit stable UUID in every environment.
# New deployments: node -e 'console.log(require("node:crypto").randomUUID())'
# Existing deployments: preserve the captured UUID; see docs/DEPLOYMENT.md.
DEPLOYMENT_ID=

# Required: Application encryption
# New deployments: openssl rand -base64 32
# Existing deployments must preserve their current encryption key.
APP_ENCRYPTION_KEY=

# Codex authentication
CODEX_AUTH_MODE=chatgpt
# Required only when CODEX_AUTH_MODE=api_key.
# OPENAI_API_KEY=

# Persistent storage
# Mount persistent storage at /data in deployments. For local development,
# replace these with separate absolute paths writable by your local user.
# Outbound network for workspace-write tasks (git clone, npm install, curl).
# "enabled" is the default. Task commands can read files outside the workspace,
# including CODEX_HOME/auth.json, so set "disabled" for an agent that works on
# untrusted repositories or web content.
# AGENT_TASK_NETWORK_ACCESS=enabled
CODEX_HOME=/data/codex
AGENT_WORKSPACE_ROOT=/data/workspaces

# Optional/advanced: existing deployment and provider overrides
# AGENT_OWNER_HANDLES is imported only when it contains exactly one E.164 phone
# and neither owner-phone variable is set. Multiple handles or email identities
# require operator migration through the dashboard.
# AGENT_OWNER_HANDLES=+15551234567
# Spectrum credentials may remain unset until Photon setup stores them on disk.
# SPECTRUM_PROJECT_ID=
# SPECTRUM_PROJECT_SECRET=
# Message intake. "stream" holds a persistent connection to Spectrum (default).
# "webhook" is for hosts that put an idle agent to sleep: Spectrum sends one
# signed request per message to /webhooks/spectrum and the host wakes the agent.
# SPECTRUM_INTAKE_MODE=stream
# Required when SPECTRUM_INTAKE_MODE=webhook: the signing secret of the webhook
# registered with Spectrum.
# SPECTRUM_WEBHOOK_SECRET=

# Optional/advanced: semantic memory
# Leave SUPERMEMORY_API_KEY empty to disable semantic memory.
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_PREFIX=imessage-agent

# Model routing
# Runtime and safety limits
INBOUND_DEBOUNCE_MS=0
MAX_EXECUTION_CONCURRENCY=3
MAX_OWNER_EXECUTION_CONCURRENCY=2
MESSAGE_RATE_LIMIT_PER_MINUTE=60
TASK_RATE_LIMIT_PER_HOUR=120
MAX_TASK_RUNTIME_MS=900000
PAIRING_MODE=off
GROUP_MODE=owner_mentions_only

# Retention and logging
RAW_MESSAGE_RETENTION_DAYS=30
FAILURE_RETENTION_DAYS=14
LOG_MESSAGE_CONTENT=false

# Server
PORT=10000
# Optional: exact origins, comma separated, of a trusted host proxy that serves
# the setup dashboard from another origin, for example https://maritime.sh.
# DASHBOARD_TRUSTED_ORIGINS=
